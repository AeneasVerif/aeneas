def count_down_loop.body
  {B : Type _} (BlaInst : Bla B) (b : B) (n : Std.U32) (acc : Std.U32) :
  Result (ControlFlow (Std.U32 × Std.U32) Std.U32)
  := do
  if n > 0#u32
  then
    let i ← BlaInst.to_num b
    let acc1 ← acc + i
