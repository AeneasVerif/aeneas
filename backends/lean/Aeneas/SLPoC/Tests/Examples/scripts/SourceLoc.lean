  .controls fieldset { border: 0; padding: 0; margin: 0; display: flex; gap: .8rem;
                       align-items: center; flex-wrap: wrap; }

  .totals { display: grid; grid-template-columns: 9rem 1fr 15rem; gap: .4rem 1rem;
            align-items: center; margin: 1rem 0; }

  .example { border: 1px solid var(--line); border-radius: 8px; margin: .5rem 0;
             background: #fff; }
  .example[open] { box-shadow: 0 1px 3px rgba(0,0,0,.08); }
  .example > summary { list-style: none; cursor: pointer; padding: .6rem .9rem; }
  .example > summary::-webkit-details-marker { display: none; }
  .example > summary:hover { background: var(--panel); }
  .row { display: grid; grid-template-columns: 16rem 6.5rem 1fr 13rem; gap: .3rem .9rem;
         align-items: center; }
  .row .title { grid-row: span 3; align-self: center; display: flex;
                flex-direction: column; align-items: flex-start; gap: .35rem;
                font-weight: 600; }
  .row .sub { color: var(--dim); font-size: .88em; text-align: right; }
  .filerow { display: grid; grid-template-columns: 8rem 1fr 13rem; gap: .3rem .9rem;
             align-items: center; margin: .3rem 0 .1rem; }
  .badge { justify-self: start; font-size: .78em; font-weight: 700; letter-spacing: .02em;
           padding: .1rem .45rem; border-radius: 999px; text-transform: uppercase; }
  .v-yes { background: #eaf6ec; color: #1a7f37; }
