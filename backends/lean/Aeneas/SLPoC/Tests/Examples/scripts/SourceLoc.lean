  .body { padding: .2rem .9rem 1rem; border-top: 1px solid var(--line); }
  .reason { background: var(--panel); border-left: 3px solid var(--line);
            padding: .5rem .8rem; margin: .8rem 0; }
  table { border-collapse: collapse; margin: .4rem 0 1rem; width: 100%; }
  th, td { border-bottom: 1px solid var(--line); padding: .25rem .6rem; text-align: right;
           font-variant-numeric: tabular-nums; }
