  .legend i { width: .85rem; height: .85rem; border-radius: 3px; display: inline-block; }

  .controls { display: flex; gap: 1.5rem; flex-wrap: wrap; align-items: center;
              padding: .7rem 1rem; background: var(--panel); border: 1px solid var(--line);
              border-radius: 8px; margin: 1rem 0; }
