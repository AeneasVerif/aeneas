  body[data-hide~='yes'] .example[data-verdict='yes'],
  body[data-hide~='no'] .example[data-verdict='no'],
  body[data-hide~='na'] .example[data-verdict='na'] { display: none; }
"

def script : String := "
  const body = document.body, list = document.getElementById('examples');
  const rows = Array.from(list.children);
  document.getElementById('scale').addEventListener('change', e => {
    body.dataset.scale = e.target.value;
  });
  const keys = {
    name: r => r.dataset.name.toLowerCase(),
    port: r => -Number(r.dataset.port),
    proof: r => -Number(r.dataset.proofshare),
    source: r => -Number(r.dataset.source),
    ratio: r => -Number(r.dataset.ratio)
  };
  document.getElementById('sort').addEventListener('change', e => {
    const key = keys[e.target.value];
    rows.slice().sort((a, b) => {
      const x = key(a), y = key(b);
      return x < y ? -1 : x > y ? 1 : 0;
    }).forEach(r => list.appendChild(r));
  });
  function hidden() {
    return Array.from(document.querySelectorAll('input[name=verdict]'))
      .filter(i => !i.checked).map(i => i.value).join(' ');
  }
  for (const input of document.querySelectorAll('input[name=verdict]'))
    input.addEventListener('change', () => { body.dataset.hide = hidden(); });
  document.getElementById('expand').addEventListener('click', () => {
    const open = rows.some(r => !r.open);
    rows.forEach(r => { r.open = open; });
  });
"


/-- The declaration table of one file. -/
def renderDecls (f : FileReport) : String := Id.run do
  if f.decls.isEmpty then return ""
  let scale := f.decls.foldl (fun m d => max m d.counts.total) 1
  let mut out := s!"<details class='decls'><summary>{f.decls.size} declarations</summary>\
    <table><thead><tr><th>Declaration</th><th>Kind</th><th>Lines</th>\
    <th>Code</th><th>Spec</th><th>Proof</th><th class='barcell'></th></tr></thead><tbody>"
  for d in f.decls do
    out := out ++ s!"<tr><td><code>{escapeHtml d.decl.name}</code></td>\
      <td class='dim'>{escapeHtml d.decl.kind}</td><td class='n'>{d.counts.total}</td>\
      <td>{d.counts.code}</td><td>{d.counts.spec}</td><td>{d.counts.proof}</td>\
      <td class='barcell'>{bar d.counts scale}</td></tr>"
  return out ++ "</tbody></table></details>"

def renderFile (f : FileReport) : String := Id.run do
  let name :=
    match f.url with
    | some url => s!"<a href='{escapeHtml url}'><code>{escapeHtml f.path}</code></a>"
    | none => s!"<code>{escapeHtml f.path}</code>"
  let safety :=
    match f.safe with
    | some true => "<span class='safe'>safe Rust</span>"
    | some false => "<span class='unsafe'>uses <code>unsafe</code></span>"
    | none => ""
  let mut out := s!"<div class='filetitle'><span class='role {f.role}'>{f.role}</span>\
    {name} <span class='dim'>{f.language.toString}, {f.physicalLines} physical lines</span> \
    {safety}</div>"
  if let some note := f.note then
    out := out ++ s!"<p class='dim'>{richText note}</p>"
  out := out ++ s!"<div class='filerow'><span class='sub'>relevant</span>\
    <span>{bar f.counts (max f.counts.total 1)}</span>\
    <span>{countsCell f.counts}</span></div>\
    <p class='dim'>{percent f.counts.verification f.counts.total} of it is \
    specification and proof.</p>"
  return out ++ renderDecls f

def renderExample (e : ExampleReport) (scale : Nat) : String := Id.run do
  let verdictKey := if e.verdict == "n/a" then "na" else e.verdict
  let proofShare := 1000 * e.port.verification / max e.port.total 1
  let comparable := e.coverage == "full" && e.source.total > 0
  -- How much bigger the verified port is than the artifact it ports.  A port
  -- that answers only a fragment of its artifact sorts last: dividing the two
  -- would compare a kernel against a library.
  let ratioKey := if comparable then 1000 * e.port.total / e.source.total else 0
  let mut out := s!"<details class='example' data-verdict='{verdictKey}' \
    data-name='{escapeHtml e.name}' data-port='{e.port.total}' \
    data-source='{e.source.total}' data-proofshare='{proofShare}' data-ratio='{ratioKey}'>\
    <summary><div class='row'>\
    <span class='title'><code>{escapeHtml e.name}</code>\
    <span class='badge {verdictClass e.verdict}' title='{verdictTitle e.verdict}'>\
    {verdictLabel e.verdict}</span></span>"
  let line (label title : String) (c : Counts) (tag : String) : String :=
    s!"<span class='sub' title='{title}'>{label}</span><span>{bar c scale}</span>\
      <span>{countsCell c} {tag}</span>"
  -- How this port compares with the artifact above it, when the two compare.
  let portTag :=
    if e.source.total == 0 then ""
    else if comparable then
      s!"<span class='ratio' title='the port divided by the artifact above'>\
        {ratio e.port.total e.source.total}</span>"
    else "<span class='frag' title='the port answers part of that file, so the two \
      are not a ratio'>fragment</span>"
  out := out ++
    line "artifact" "the file this port answers" e.source "" ++
    line "Aeneas+SL" "this port" e.port portTag ++
    line "Rust" "an unverified Rust implementation of the same structure"
      e.reference ""
  out := out ++ "</div></summary><div class='body'>"
  if let some note := e.note then
    out := out ++ s!"<p>{richText note}</p>"
  out := out ++ s!"<p class='reason'><strong>{verdictLabel e.verdict}</strong> — \
    {richText e.reason}</p>"
  if e.source.total > 0 then
    out := out ++ s!"<p class='reason'><strong>Covers the artifact: \
      {escapeHtml e.coverage}</strong> — {richText e.coverageNote}</p>"
  for f in e.files do
    out := out ++ renderFile f
  return out ++ "</div></details>"

/-- The declarations that cost the most proof, over every port. -/
def renderHotspots (files : Array FileReport) : String := Id.run do
  let mut all : Array (String × DeclReport) := #[]
  for f in files do
    if f.role == "port" then
      for d in f.decls do
        if d.counts.proof > 0 then all := all.push (f.example_, d)
  -- A total order, so that the ranking never depends on how the sort breaks a tie.
  let sorted := all.qsort fun a b =>
    if a.2.counts.proof != b.2.counts.proof then a.2.counts.proof > b.2.counts.proof
    else if a.2.counts.total != b.2.counts.total then a.2.counts.total > b.2.counts.total
    else if a.1 != b.1 then a.1 < b.1
    else a.2.decl.name < b.2.decl.name
  let top := sorted.extract 0 (min 20 sorted.size)
  if top.isEmpty then return ""
  let scale := top.foldl (fun m (_, d) => max m d.counts.total) 1
  let mut out := "<h2>Where the proof lines are</h2><p>The twenty declarations of \
    the ports that cost the most proof.</p><table><thead><tr><th>Declaration</th>\
    <th>Example</th><th>Lines</th><th>Code</th><th>Spec</th><th>Proof</th>\
    <th class='barcell'></th></tr></thead><tbody>"
  for (example_, d) in top do
    out := out ++ s!"<tr><td><code>{escapeHtml d.decl.name}</code></td>\
      <td class='dim'>{escapeHtml example_}</td><td class='n'>{d.counts.total}</td>\
      <td>{d.counts.code}</td><td>{d.counts.spec}</td>\
      <td class='n'>{d.counts.proof}</td>\
      <td class='barcell'>{bar d.counts scale}</td></tr>"
  return out ++ "</tbody></table>"

def renderHtml (examples : Array ExampleReport) (files : Array FileReport)
    (manifest : String) (failures : Array String) : String := Id.run do
  let ports := files.filter (·.role == "port")
  let sources := files.filter (·.role == "source")
  let references := files.filter (·.role == "reference")
  let scale := examples.foldl
    (fun m e => max m (max e.port.total (max e.source.total e.reference.total))) 1
  let count (verdict : String) : Nat := (examples.filter (·.verdict == verdict)).size
  let mut out := s!"<!DOCTYPE html>\n<html lang='en'><head><meta charset='utf-8'>\
    <meta name='viewport' content='width=device-width, initial-scale=1'>\
    <title>SLPoC — lines of code against the original artifacts</title>\
    <style>{style}</style></head><body data-scale='absolute' data-hide=''>"
  out := out ++ "<h1>Lines of code against the original artifacts</h1>"
  unless failures.isEmpty do
    out := out ++ s!"<p class='warning'><strong>This run is incomplete.</strong> \
      {failures.size} file(s) the manifest names could not be read, so the counts \
      below are short of them: {escapeHtml (String.intercalate ", " failures.toList)}.\
      </p>"
  out := out ++ "\
    <p>Every example of <code>Aeneas/SLPoC/Tests/Examples</code> beside the artifact \
    it ports and, where one exists, beside an <em>unverified</em> Rust implementation \
    of roughly the same data structure.</p>\
    <ul>\
    <li>Comments and blank lines do not count, and neither does a line left under \
    four characters wide once its comments are removed.</li>\
    <li>Delimiters alone do not count: <code>}</code>, <code>);</code>, \
    <code>·</code>.</li>\
    <li>Import, module and scope boilerplate does not count: <code>import</code>, \
    <code>namespace</code>, <code>open</code>, <code>use</code>, <code>mod</code>, \
    <code>Require</code>.</li>\
    <li>A Rust attribute carrying no verification content does not count: \
    <code>#[inline]</code>, <code>#[derive(…)]</code>, <code>#[stable(…)]</code>. \
    <code>#[requires(…)]</code> and <code>#[verifier::…]</code> do.</li>\
    <li>Every line that remains is charged to one of three buckets.</li>\
    </ul>"
  out := out ++ "<p>Which bucket a line lands in is decided by the construct it \
    uses, so each language is read on its own terms.</p>\
    <ul>\
    <li><strong>Lean</strong> — <code>def</code>, <code>structure</code> and \
    <code>inductive</code> are code; a <code>theorem</code> or <code>lemma</code> \
    statement, a <code>def</code> valued in <code>IProp</code> or <code>Prop</code>, \
    and <code>@[…]</code>/<code>attribute</code> are spec; what follows \
    <code>:= by</code>, and <code>termination_by</code>/<code>decreasing_by</code>, \
    are proof.</li>\
    <li><strong>Rust, Verus, Creusot</strong> — <code>exec fn</code>, \
    <code>struct</code> and <code>enum</code> are code; <code>spec fn</code>, \
    <code>#[logic]</code>, the <code>requires</code>/<code>ensures</code>/\
    <code>decreases</code>/<code>invariant</code> clauses and <code>Ghost&lt;…&gt;</code> \
    fields are spec; <code>proof fn</code> bodies, <code>proof { … }</code>, \
    <code>assert</code>/<code>assume</code>/<code>reveal</code>, <code>let ghost</code> \
    and <code>let tracked</code> are proof.</li>\
    <li><strong>F*, Pulse</strong> — <code>fn</code> bodies, <code>let</code> and \
    <code>type</code> are code; <code>requires</code>/<code>ensures</code>/\
    <code>preserves</code>/<code>returns</code>/<code>invariant</code> and \
    <code>slprop</code>-valued definitions are spec; <code>ghost fn</code>, \
    <code>Lemma</code>s and the ghost steps <code>assert</code>/<code>rewrite</code>/\
    <code>fold</code>/<code>unfold</code>/<code>with … .</code> are proof.</li>\
    <li><strong>Rocq, Iris</strong> — a HeapLang program (<code>: expr</code>, \
    <code>: val</code>, <code>λ:</code>) is code; <code>Lemma</code> and \
    <code>Theorem</code> statements, the other <code>Definition</code>s, \
    <code>Notation</code> and <code>Ltac</code> are spec; \
    <code>Proof. … Qed.</code> is proof.</li>\
    <li>The rule is a heuristic, and it is deliberately generous to code: a ratio \
    read off it understates rather than overstates what verification costs.</li>\
    </ul>"
  out := out ++ "<div class='legend'>\
    <span class='key'><i class='seg code' style='width:.85rem'></i> \
    <strong>code</strong></span>\
    <span class='key'><i class='seg spec' style='width:.85rem'></i> \
    <strong>spec</strong></span>\
    <span class='key'><i class='seg proof' style='width:.85rem'></i> \
    <strong>proof</strong></span></div>"
  -- Only a port that answers the whole of its artifact may be divided by it.
  let comparable := examples.filter fun e => e.coverage == "full" && e.source.total > 0
  let fragments := examples.filter fun e => e.coverage == "fragment" && e.source.total > 0
  let comparablePort := comparable.foldl (fun acc e => acc.union e.port) {}
  let comparableSource := comparable.foldl (fun acc e => acc.union e.source) {}
  let compScale := max comparablePort.total comparableSource.total
  out := out ++ s!"<h2>The comparable examples</h2>\
    <p>Adding every example up would compare a kernel against a library: \
    {fragments.size} of the ports deliberately answer part of a larger upstream file \
    — one of them a deliberately downscaled benchmark. Only the {comparable.size} \
    whose port answers its artifact as a whole can be divided by it, and only those \
    are added up here.</p><div class='totals'>"
  let totalRow (label : String) (c : Counts) (tag : String) : String :=
    s!"<span><strong>{label}</strong></span>\
      <span>{bar c compScale}</span><span>{countsCell c} {tag}</span>"
  out := out ++ totalRow "Original artifacts" comparableSource ""
  out := out ++ totalRow "Aeneas+SL" comparablePort
    s!"<span class='ratio' title='the port divided by the artifact above'>\
      {ratio comparablePort.total comparableSource.total}</span>"
  out := out ++ "</div>"
  out := out ++ s!"<p>Over those {comparable.size} examples the port costs \
    {ratio comparablePort.total comparableSource.total} the artifact it answers: \
    {ratio comparablePort.code comparableSource.code} on what runs, and \
    {ratio comparablePort.verification comparableSource.verification} on \
    specification and proof. It spends \
    {percent comparablePort.verification comparablePort.total} of its lines on \
    verification, the artifact \
    {percent comparableSource.verification comparableSource.total}.</p>"
  out := out ++ s!"<p class='dim'>Every file is still counted, and every example \
    below still shows both figures: {ports.size} ports, {sources.size} artifacts over \
    {(examples.filter (·.source.total > 0)).size} examples — several ports answer more \
    than one upstream file, a Pulse module and its interface or the four chapters of \
    the Iris tutorial — and {references.size} unverified Rust references, which being \
    unverified are all <code>code</code>. The {fragments.size} fragmentary examples are \
    marked as such, and sort last by ratio.</p>"
  out := out ++ s!"<h2>Can it be written in safe Rust?</h2>\
    <p>Aeneas translates <em>safe</em> Rust, so each example records whether its \
    program is expressible in that fragment at all — a property of the aliasing the \
    example is about, not of its proof.</p><ul>\
    <li><span class='badge v-yes'>Safe Rust</span> {count "yes"} examples — \
    expressible in safe Rust, at worst by replacing a raw pointer with an index, a \
    <code>Box</code>, or a <code>&amp;mut</code>.</li>\
    <li><span class='badge v-no'>Unsafe Rust</span> {count "no"} — the aliasing \
    <em>is</em> the point: intrusive links, a doubly-linked list, a free list threaded \
    through freed memory, hardware page tables.</li>\
    <li><span class='badge v-na'>N/A</span> {count "n/a"} — no single answer applies: \
    the file holds no program at all, or part of it is safe and the rest needs \
    <code>unsafe</code>, a borrow checker that does not exist yet, or has no \
    sequential Rust counterpart.</li></ul>"
  out := out ++ "<h2>Examples</h2><div class='controls'>\
    <label>Bars <select id='scale'>\
    <option value='absolute'>to a common scale</option>\
    <option value='relative'>as proportions</option></select></label>\
    <label>Sort by <select id='sort'>\
    <option value='name'>name</option>\
    <option value='port'>size of the port</option>\
    <option value='proof'>share of specification and proof</option>\
    <option value='source'>size of the artifact</option>\
    <option value='ratio'>port ÷ artifact</option></select></label>\
    <fieldset><span>Show</span>\
    <label><input type='checkbox' name='verdict' value='yes' checked> Safe Rust</label>\
    <label><input type='checkbox' name='verdict' value='no' checked> Unsafe Rust</label>\
    <label><input type='checkbox' name='verdict' value='na' checked> N/A</label>\
    </fieldset><button type='button' id='expand'>Expand all</button></div>"
  out := out ++ "<p>Each example carries three bars, one per line, all drawn to a \
    scale common to the whole section, so their lengths may be compared down the \
    page as well as within an example:</p><ul>\
    <li><strong>artifact</strong> — the upstream file the port answers, in Verus, \
    Pulse, Creusot or Rocq;</li>\
    <li><strong>Aeneas+SL</strong> — this port, with the ratio between the two \
    where it answers the whole of that file;</li>\
    <li><strong>Rust</strong> — an unverified Rust implementation of roughly the \
    same structure, which having no proof is one colour only.</li></ul>\
    <p>A bar is divided into the three buckets, and hovering a segment gives its \
    count:</p>\
    <div class='legend'>\
    <span class='key'><i class='seg code' style='width:.85rem'></i> \
    <strong>code</strong></span>\
    <span class='key'><i class='seg spec' style='width:.85rem'></i> \
    <strong>spec</strong></span>\
    <span class='key'><i class='seg proof' style='width:.85rem'></i> \
    <strong>proof</strong></span>\
    <span class='key'><span class='bar empty' style='width:3rem'></span> \
    not counted</span></div>\
    <p class='dim'>The figure beside each bar is its total, then \
    <code>(code + spec + proof)</code>. Open a row for the verdicts, the files, and \
    every declaration.</p>\
    <div id='examples'>"
  for e in examples do
    out := out ++ renderExample e scale
  out := out ++ "</div>"
  out := out ++ renderHotspots files
  out := out ++ s!"<h2>Provenance</h2><p>Generated by \
    <code>Aeneas/SLPoC/Tests/Examples/scripts/SourceLoc.lean</code> from \
    <code>{escapeHtml manifest}</code>, which pins every source to a commit and to \
    its SHA-256. The numbers are also written, per file and per declaration, to \
    <code>source-loc.json</code>.</p>"
  return out ++ s!"<script>{script}</script></body></html>\n"

/-! ## Entry point -/

structure Options where
  manifest : System.FilePath := "Aeneas/SLPoC/Tests/Examples/reports/sources-manifest.json"
  examples : System.FilePath := "Aeneas/SLPoC/Tests/Examples"
  out : System.FilePath := "Aeneas/SLPoC/Tests/Examples/reports/source-loc.json"
  html : System.FilePath := "Aeneas/SLPoC/Tests/Examples/reports/source-loc.html"
  cache : System.FilePath := ".lake/source-loc-cache"
  offline : Bool := false

def usage : String :=
  "usage: lake env lean --run Aeneas/SLPoC/Tests/Examples/scripts/SourceLoc.lean \
    [-o OUT.json] [--html OUT.html] [--manifest FILE] [--examples DIR] \
    [--cache DIR] [--offline]"

partial def parseArgs (args : List String) (opts : Options := {}) : Except String Options :=
  match args with
  | [] => .ok opts
  | "-o" :: out :: rest | "--out" :: out :: rest => parseArgs rest { opts with out }
  | "--html" :: html :: rest => parseArgs rest { opts with html }
  | "--manifest" :: manifest :: rest => parseArgs rest { opts with manifest }
  | "--examples" :: examples :: rest => parseArgs rest { opts with examples }
  | "--cache" :: cache :: rest => parseArgs rest { opts with cache }
  | "--offline" :: rest => parseArgs rest { opts with offline := true }
  | arg :: _ => .error s!"unknown argument `{arg}`\n{usage}"

def main (args : List String) : IO UInt32 := do
  let opts ← match parseArgs args with
    | .ok opts => pure opts
    | .error msg => IO.eprintln msg; return 1
  let manifestText ← IO.FS.readFile opts.manifest
  let manifestJson ← IO.ofExcept (Json.parse manifestText)
  let entries ← IO.ofExcept (parseManifest manifestJson)
  IO.FS.createDirAll opts.cache
  let mut files : Array FileReport := #[]
  let mut mismatches : Array String := #[]
  -- Files the manifest names but this run could not read: without them the counts
  -- are silently short, so they belong in the report and not only on stderr.
  let mut failures : Array String := #[]
  for entry in entries do
    -- The port.
    let leanPath := opts.examples / entry.lean
    if ← leanPath.pathExists then
      let text ← IO.FS.readFile leanPath
      let (physical, counts, loose, decls) := countFile .lean text
      files := files.push
        { role := "port", example_ := entry.lean, path := leanPath.toString
          url := none, downloadUrl := none, language := .lean
          physicalLines := physical, counts
          looseCounts := loose, sha256 := none, sha256Expected := none
          safe := none, note := none, decls }
    else
      IO.eprintln s!"warning: {leanPath} does not exist"
    -- The artifacts it ports, then the unverified Rust implementations of the
    -- same data structure.
    for (role, srcs) in [("source", entry.sources), ("reference", entry.references)] do
      for src in srcs do
        unless src.downloadable do
          IO.println s!"skipping {src.url}: {src.reason.getD "not downloadable"}"
          continue
        let some path ← fetch opts.cache src.url opts.offline
          | failures := failures.push s!"{entry.lean}: {src.url}"
            continue
        let text ← IO.FS.readFile path
        let digest ← sha256Of path
        if let (some a, some b) := (digest, src.sha256) then
          if a != b then
            mismatches := mismatches.push s!"{src.url}: expected {b}, got {a}"
        let (physical, counts, loose, decls) := countFile src.language text
        files := files.push
          { role, example_ := entry.lean, path := src.path
            url := some src.viewUrl
            downloadUrl := if src.viewUrl == src.url then none else some src.url
            language := src.language, physicalLines := physical
            counts, looseCounts := loose, sha256 := digest, sha256Expected := src.sha256
            safe := src.safe, note := src.note, decls }
  -- Per-example comparison.
  let mut examples : Array ExampleReport := #[]
  let mut comparisons : Array Json := #[]
  for entry in entries do
    let ofRole (role : String) := files.filter fun f => f.example_ == entry.lean && f.role == role
    let port := ofRole "port"
    let source := ofRole "source"
    let reference := ofRole "reference"
    let (verdict, reason) := entry.safeRust.getD ("n/a", "")
    let (coverage, coverageNote) := entry.coverage.getD ("n/a", "")
    examples := examples.push
      { name := entry.lean, project := entry.project, note := entry.note
        verdict, reason, coverage, coverageNote
        port := sumCounts port, source := sumCounts source
        reference := sumCounts reference
        files := files.filter (·.example_ == entry.lean) }
    comparisons := comparisons.push <| Json.mkObj
      [ ("example", Json.str entry.lean), ("project", Json.str entry.project),
        ("note", optJson entry.note),
        ("safeRust",
          match entry.safeRust with
          | none => Json.null
          | some (verdict, reason) =>
            Json.mkObj [("verdict", Json.str verdict), ("reason", Json.str reason)]),
        ("coverage",
          match entry.coverage with
          | none => Json.null
          | some (verdict, note) =>
            Json.mkObj [("verdict", Json.str verdict), ("note", Json.str note)]),
        ("port", countsJson (sumCounts port)),
        ("source", countsJson (sumCounts source)),
        ("reference", countsJson (sumCounts reference)),
        -- Only a port that answers the whole of its artifact may be divided by it.
        ("ratio",
          if entry.coverage.any (·.1 == "full") && (sumCounts source).total > 0 then
            Json.str (ratio (sumCounts port).total (sumCounts source).total)
          else Json.null),
        ("sourceFiles", Json.arr (source.map fun f => Json.str (f.url.getD f.path))),
        ("referenceFiles", Json.arr (reference.map fun f => Json.str (f.url.getD f.path))),
        ("sourcesCounted", toJson source.size),
        ("sourcesNotCounted",
          toJson (entry.sources.filter (!·.downloadable) |>.size)) ]
  let ports := files.filter (·.role == "port")
  let sources := files.filter (·.role == "source")
  let references := files.filter (·.role == "reference")
  let report := Json.mkObj
    [ ("generatedBy", Json.str "Aeneas/SLPoC/Tests/Examples/scripts/SourceLoc.lean")
    , ("manifest", Json.str opts.manifest.toString)
    , ("countingRules", Json.mkObj
        [ ("relevantLine", Json.str
            "at least 4 characters after comment removal, not delimiters only, not \
             import/module/scope boilerplate")
        , ("uncountedAttribute", Json.str
            "a Rust attribute with no verification content (`#[inline]`, \
             `#[derive(…)]`, `#[stable(…)]`) is metadata, and is not counted")
        , ("code", Json.str "computational content executed at run time")
        , ("spec", Json.str
            "specifications and annotations: pre/postconditions, invariants, \
             representation predicates, theorem statements, ghost state, attributes")
        , ("proof", Json.str
            "proof material: tactic scripts, proof blocks, asserts, ghost steps") ])
    , ("totals", Json.mkObj
        [ ("ports", countsJson (sumCounts ports))
        , ("sources", countsJson (sumCounts sources))
        , ("references", countsJson (sumCounts references))
        , ("portFiles", toJson ports.size)
        , ("sourceFiles", toJson sources.size)
        , ("referenceFiles", toJson references.size)
        , ("safeRust", Json.mkObj (["yes", "no", "n/a"].map fun verdict =>
            (verdict, toJson (entries.filter
              (fun e => e.safeRust.any (·.1 == verdict)) |>.size))))
        , ("declarations", toJson (files.foldl (· + ·.decls.size) 0)) ])
    , ("checksumMismatches", Json.arr (mismatches.map Json.str))
    , ("downloadFailures", Json.arr (failures.map Json.str))
    , ("complete", Json.bool (failures.isEmpty && mismatches.isEmpty))
    , ("comparisons", Json.arr comparisons)
    , ("files", Json.arr (files.map fileJson)) ]
  IO.FS.createDirAll (opts.out.parent.getD ".")
  IO.FS.writeFile opts.out (report.pretty ++ "\n")
  IO.FS.createDirAll (opts.html.parent.getD ".")
  IO.FS.writeFile opts.html
    (renderHtml examples files opts.manifest.toString failures)
  for m in mismatches do
    IO.eprintln s!"warning: checksum mismatch for {m}"
  for f in failures do
    IO.eprintln s!"warning: could not count {f}; the totals are short of it"
  let p := sumCounts ports
  let s := sumCounts sources
  IO.println s!"ports:   {p.total} relevant lines ({p.code} code, {p.spec} spec, \
    {p.proof} proof) over {ports.size} files"
  IO.println s!"sources: {s.total} relevant lines ({s.code} code, {s.spec} spec, \
    {s.proof} proof) over {sources.size} files"
  let r := sumCounts references
  IO.println s!"refs:    {r.total} relevant lines ({r.code} code, {r.spec} spec, \
    {r.proof} proof) over {references.size} files"
  IO.println s!"wrote {opts.out} and {opts.html}"
  return 0

end Aeneas.SepLogic.SourceLoc

def main (args : List String) : IO UInt32 := Aeneas.SepLogic.SourceLoc.main args
