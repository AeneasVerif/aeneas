import Lean

/-! # Tracking the Rust source of the extracted declarations

The `@[rust_source]` attribute elaborates by adding the span information to an environment extension
to keep track of Rust source file.

The paths of those spans are relative to the directory Charon was called from, which is not a
directory Lean knows anything about, so we look for it on demand.
-/

open Lean

namespace Aeneas.RustSource

/-- The span of a Rust item, as reported by Charon. The numbering conventions are those used
by rustc -/
structure Span where
  /-- Path of the Rust file the item comes from.-/
  file : String
  /-- Line of the beginning of the item (1-based). -/
  begLine : Nat
  /-- Column of the beginning of the item (0-based). -/
  begCol : Nat
  /-- Line of the end of the item (1-based). -/
  endLine : Nat
  /-- Column of the end of the item (0-based). -/
  endCol : Nat
deriving Inhabited, Repr, BEq

/-- Render a span the way Aeneas renders it in the doc comments, e.g.,
`'tests/src/no_nested_borrows.rs', lines 7:0-10:1`. -/
def Span.toString (s : Span) : String :=
  s!"'{s.file}', lines {s.begLine}:{s.begCol}-{s.endLine}:{s.endCol}"

instance : ToString Span := ⟨Span.toString⟩
instance : ToMessageData Span := ⟨fun s => s.toString⟩

/-- Maps the declarations generated by Aeneas to the span of the Rust item they were extracted
from. -/
initialize rustSourceExt : MapDeclarationExtension Span ← mkMapDeclarationExtension

/-- Retrieve the span of the Rust item `declName` was extracted from, if there is one. -/
def getSpan? (env : Environment) (declName : Name) : Option Span :=
  rustSourceExt.find? (level := .exported) env declName

/-- Attach the span of a Rust item to a declaration.

The syntax is `rust_source "FILE" BEG_LINE BEG_COL END_LINE END_COL`, where the lines are 1-based
and the columns 0-based, as in:
```
@[rust_source "tests/src/no_nested_borrows.rs" 7 0 10 1]
structure Pair (T1 : Type) (T2 : Type) where
  x : T1
  y : T2
```

This attribute is generated by Aeneas: there should be no need to write it by hand.
-/
syntax (name := rustSource) "rust_source" str num num num num : attr

initialize registerBuiltinAttribute {
  name := `rustSource
  descr := "span of the Rust item a declaration was extracted from"
  add := fun declName stx attrKind => do
    unless attrKind == .global do
      throwError "'rust_source' can only be used as a global attribute"
    let `(attr| rust_source $file $begLine $begCol $endLine $endCol) := stx
      | Elab.throwUnsupportedSyntax
    let span : Span := {
      file := file.getString
      begLine := begLine.getNat, begCol := begCol.getNat
      endLine := endLine.getNat, endCol := endCol.getNat
    }
    modifyEnv (rustSourceExt.insert · declName span)
}

/-! ## Locating the Rust sources

The paths of the spans are relative to the directory Charon was called from and Aeneas does not
usually know it, so we resolve it on request.

This is done by walking up the directories until we find a path that matches the root of the
relative path we're searching for.

The `rust_source_root` command below covers the layouts this search can not handle -/

/-- Look for a directory in which `relFile` exists among `dir` and its parents, closest first. -/
private partial def searchRoot? (dir : System.FilePath) (relFile : System.FilePath) :
    IO (Option System.FilePath) := do
  if ← (dir / relFile).pathExists then
    return some dir
  match dir.parent with
  | some parent => searchRoot? parent relFile
  | none => return none

/-- The roots we already found, mapping the directory containing a generated Lean file to the
directory the spans of that file are relative to. This speeds up future searches, so we don't incur
the search cost on each LSP request. -/
initialize rootCache : IO.Ref (Std.HashMap System.FilePath System.FilePath) ← IO.mkRef {}

/-- Find the directory the spans of a generated Lean file are relative to, where `leanDir` is the
directory containing that Lean file and `relFile` the path of one of the Rust files we are looking
for. -/
def findRoot? (leanDir : System.FilePath) (relFile : System.FilePath) :
    IO (Option System.FilePath) := do
  if let some root := (← rootCache.get)[leanDir]? then
    if ← (root / relFile).pathExists then
      return some root
  let some root ← searchRoot? leanDir relFile
    | return none
  rootCache.modify (·.insert leanDir root)
  return some root

/-! ### Overriding the search -/

/-- Maps a module to the directory the paths of its `@[rust_source]` spans are relative to, as
declared by `rust_source_root`.

Contrary to `rustSourceExt` there is at most one entry per module, so there are few enough
entries to simply merge all of them at import time.
-/
initialize rustSourceRootExt : SimplePersistentEnvExtension (Name × String) (NameMap String) ←
  registerSimplePersistentEnvExtension {
    addEntryFn    := fun m (mod, root) => m.insert mod root
    addImportedFn := fun es =>
      es.foldl (fun m es => es.foldl (fun m (mod, root) => m.insert mod root) m) {}
  }

/-- Retrieve the directory the `@[rust_source]` spans of module `mod` were declared to be relative
to, if `rust_source_root` was used in that module. -/
def getRoot? (env : Environment) (mod : Name) : Option String :=
  (rustSourceRootExt.getState env).find? mod

/-- Declare the directory the `@[rust_source]` spans of the current file are relative to, i.e. the
directory Charon was called from, given relatively to the directory containing the current file.

This is only needed when the Rust sources are not below any of the directories containing the
current file.
-/
syntax (name := rustSourceRootCmd) "rust_source_root " str : command

open Elab Command in
@[command_elab rustSourceRootCmd]
def elabRustSourceRoot : CommandElab := fun stx => do
  let `(command| rust_source_root $root:str) := stx | throwUnsupportedSyntax
  let mod ← getMainModule
  modifyEnv (rustSourceRootExt.addEntry · (mod, root.getString))

/-- The path of the Rust file `span` points to, for a declaration belonging to module `mod`, whose
Lean file sits in `leanDir`. Returns `none` when we can not find that file. -/
def resolveSpanFile? (env : Environment) (mod : Name) (leanDir : System.FilePath) (span : Span) :
    IO (Option System.FilePath) := do
  let file : System.FilePath := span.file
  let path? : Option System.FilePath ←
    if file.isAbsolute then pure (some file)
    else match getRoot? env mod with
      | some root =>
        let root : System.FilePath := root
        pure (some ((if root.isAbsolute then root else leanDir / root) / file))
      | none => pure ((← findRoot? leanDir file).map (· / file))
  let some path := path?
    | return none
  unless ← path.pathExists do return none
  return some (← IO.FS.realPath path)

end Aeneas.RustSource
